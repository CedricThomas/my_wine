# Build directory
build/

# Object files (defense in depth, already covered by build/)
*.o

# Dependency files
*.d

# GDB debug scripts
*.gdb

# Windows executables
*.exe

# Windows libraries
*.dll

# Main binaries
my_wine
my_wine64
my_wine32

# Test binaries (ignore all in tests/, keep .c sources)
tests/*
!tests/*.c
!tests/*.h

# Auto-generated files
include/crt_offsets_generated.h
src/syscall/dispatcher_generated.c

# Python
__pycache__/
*.pyc

# Sample game assets (zip is tracked; unpacked folder is ignored)
samples/unpacked/
