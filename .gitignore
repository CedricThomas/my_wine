# Build directory
build/

# Object files (defense in depth, already covered by build/)
*.o

# Dependency files
*.d

# GDB debug scripts
*.gdb

# Windows executables
*.exe

# Windows libraries
*.dll

# Main binary
my_wine

# Test binaries (ignore all in tests/, keep .c sources)
tests/*
!tests/*.c

# Auto-generated files
include/crt_offsets_generated.h
src/syscall/dispatcher_generated.c

# Python
__pycache__/
*.pyc

# DOOM95 binary assets (zip is tracked; unpacked files are ignored)
doom95/*.EXE
doom95/*.dll
doom95/*.DLL
doom95/*.wad
doom95/*.WAD
doom95/*.vxd
doom95/*.VXD
doom95/DIRECTX/
