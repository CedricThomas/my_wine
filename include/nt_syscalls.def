# nt_syscalls.def — Source of truth for dispatcher auto-generation
# Format: SYSCALL_NUM  SyscallName  handler_function  pattern_type
# Pattern types: simple | validate | inout | multi

0x05  NtCallbackReturn          handler_NtCallbackReturn         simple
0x07  NtQueryInformationProcess handler_NtQueryInformationProcess multi
0x09  NtQuerySystemTime         handler_NtQuerySystemTime        inout
0x0F  NtClose                   handler_NtClose                  simple
0x18  NtAllocateVirtualMemory   handler_NtAllocateVirtualMemory  multi
0x19  NtFreeVirtualMemory       handler_NtFreeVirtualMemory      multi
0x1A  NtDelayExecution          handler_NtDelayExecution         inout
0x1E  NtReleaseMutex            handler_NtReleaseMutex           simple
0x24  NtGetContextThread        handler_NtGetContextThread       validate
0x26  NtSetContextThread        handler_NtSetContextThread       validate
0x28  NtMapViewOfSection        handler_NtMapViewOfSection       multi
0x29  NtUnmapViewOfSection      handler_NtUnmapViewOfSection     simple
0x2A  NtTerminateProcess        handler_NtTerminateProcess       simple
0x3C  NtReadFile                handler_NtReadFile               multi
0x3D  NtWriteFile               handler_NtWriteFile              multi
0x44  NtCreateMutex             handler_NtCreateMutex            inout
0x48  NtCreateEvent             handler_NtCreateEvent            inout
0x4A  NtCreateSection           handler_NtCreateSection          multi
0x4E  NtCreateThreadEx          handler_NtCreateThreadEx         inout
0x4F  NtOpenFile                handler_NtOpenFile               multi
0x55  NtQueryPerformanceCounter handler_NtQueryPerformanceCounter inout
0x56  NtQueryPerformanceFrequency handler_NtQueryPerformanceFrequency inout
0x5C  NtSetEvent                handler_NtSetEvent               inout
0x5E  NtResetEvent              handler_NtResetEvent             inout
0x03  NtWaitForSingleObject     handler_NtWaitForSingleObject    inout
